   "from_schema": 1,
   "harm": "interpreting empty setting values as resetting to defaults alters existing configuration semantics",
   "hash": "a49ac6c636f173ba",
   "history": [
    {
     "at": "2026-09-18T03:15:58+00:00",
     "blocking": true,
     "by": "run:20260918-0314",
     "cause": "c:579068737",
     "status": "resolved"
    }
   ],
   "id": "c:579068737",
   "kind": "interface",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "making `-value=` reset things to defaults changes the meaning of existing configs, and while that might be fine if it were a new system, it doesn't seem useful enough to justify introducing an incompatibility",
   "request": "",
   "status": "answered",
   "status_by": {
    "at": "2020-09-01",
    "by": "ryanofsky",
    "id": "rc:481492984",
    "quote": "Making the change you suggest would require either choosing a new SettingsValue representation or making it impossible to to distinguish -setting from -setting=\"\", and would make the implementation more complicated, and would have no actual utility."
   },
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/16545#issuecomment-579068737"
  },
  {
   "association": "MEMBER",
   "at": "2024-08-05",
   "author": "maflcko",
   "author_replies": [
