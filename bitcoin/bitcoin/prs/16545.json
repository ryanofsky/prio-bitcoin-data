   },
   "from_schema": 1,
   "harm": "allowing multi-flag combinations creates footguns and subtle behavioral inconsistencies across existing options",
   "hash": "b86e9649a23b19fb",
   "history": [
    {
     "at": "2026-09-18T03:15:58+00:00",
     "blocking": true,
     "by": "run:20260918-0314",
     "cause": "rc:1703839679",
     "status": "resolved"
    }
   ],
   "id": "rc:1703839679",
   "kind": "approach",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "Merging this as-is and unlocking the footgun just seems too risky to me. This is why I asked to make this an enum class for now, disallowing combinations, so that they can be reviewed and added later on",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2024-08-23",
    "by": "ryanofsky",
    "id": "r:2256044988",
    "quote": "dropping support for flag combinations and fixing a commit message as suggested"
   },
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/16545#discussion_r1703839679"
  },
