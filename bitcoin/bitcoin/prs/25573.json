     "status": "resolved"
    }
   ],
   "id": "c:1205515413",
   "kind": "correctness",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "bitcoind: dl-call-libc-early-init.c:37: _dl_call_libc_early_init: Assertion `sym != NULL' failed. Aborted (core dumped)",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2022-08-24",
    "by": "fanquake",
    "id": "c:1225889653",
    "quote": "Pushed a number of changes, and rebased on master. Switched from glibc 2.35 to 2.36."
   },
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/25573#issuecomment-1205515413"
  },
  {
   "association": "MEMBER",
   "at": "2026-07-22",
   "author": "willcl-ark",
   "author_replies": [
