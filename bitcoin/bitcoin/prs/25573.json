    "sha": "804b126f093c5f3aad35e2a20ec2f6d77c291eeb"
   },
   "harm": "ELF FORTIFY security check returns True even when fortification is disabled because static binaries pull in libc.a symbol definitions.",
   "hash": "9fbf105cad0bc2c3",
   "history": [
    {
     "at": "2026-09-18T03:21:16+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:3628650155",
     "status": "resolved"
    }
   ],
   "id": "rc:3628650155",
   "kind": "correctness",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "I don't think switching from `binary.imported_symbols` to `binary.symbols` provides a valid FORTIFY check for static binaries any more.",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2026-07-29",
    "by": "fanquake",
    "id": "rc:3675743445",
    "quote": "For now I've opted to just return True for any static bin; I'm not sure if a more involved approach is worthwhile, will think about it some more."
   },
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/25573#discussion_r3628650155"
  },
  {
   "association": "MEMBER",
   "at": "2026-08-11",
   "author": "sedited",
   "author_replies": [
