   ],
   "clears_with": "answer",
   "fix": {
    "at": null,
    "sha": "804b126f093c5f3aad35e2a20ec2f6d77c291eeb"
   },
   "harm": "Static binary attempts to open Guix store locale paths inherited from the build environment, leaking store paths and risking nondeterminism.",
   "hash": "c0e3fb20e4dec7ca",
   "history": [
    {
     "at": "2026-09-18T03:21:16+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "r:4905671621",
     "status": "resolved"
    }
   ],
   "id": "r:4905671621",
   "kind": "correctness",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "trying to open some locales from the guix build environment and apparently so from the inherited glibc version",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2026-08-12",
    "by": "fanquake",
    "id": "c:5268059707",
    "quote": "This is due to Guix appending `(string-append \"libc_cv_complocaledir=/run/current-system/locale/\",(version-major+minor version))` onto it's glibc configure flags. I've filtered this out"
   },
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/25573#pullrequestreview-4905671621"
  }
 ],
