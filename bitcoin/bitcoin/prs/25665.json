    "sha": "389ab06bb04dee0f056ac27760840bb09e440efb"
   },
   "harm": "Conflating error return values with multi-message reporting when util::Expected should be prioritized",
   "hash": "af398ed396db96da",
   "history": [
    {
     "at": "2026-09-18T03:21:53+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "c:3617021123",
     "status": "resolved"
    }
   ],
   "id": "c:3617021123",
   "kind": "approach",
   "pin": null,
   "quote": "I think util::Result is conflating 2 related but orthogonal needs... At this point I would prefer util::Expected be merged first (#34006).",
   "settled_by": {
    "at": "2025-12-15",
    "by": "hodlinator",
    "id": "r:3573338179",
    "quote": "The former makes it a clearer departure from util::Expected - warnings can be added and merged into parent results while still returning successful values."
   },
   "status": "resolved",
   "url": "https://github.com/bitcoin/bitcoin/pull/25665#issuecomment-3617021123"
  },
  {
   "association": "MEMBER",
   "at": "2025-12-15",
   "author": "hodlinator",
   "author_replies": [
    "rc:2787964873",
    "rc:2788139546",
    "rc:2788900844"
   ],
   "blocking": false,
   "fix": null,
   "harm": "LoadChainstate and VerifyLoadedChainstate do not use warnings or multiple errors, so applying util::Result to them is not well motivated over util::Expected",
   "hash": "301a1515e7d7c929",
   "history": [
    {
     "at": "2026-09-18T03:21:53+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:2619566751",
     "status": "open"
    }
   ],
   "id": "rc:2619566751",
   "kind": "usefulness",
   "pin": null,
   "quote": "I maintain that the current example in this PR of applying util::Result to LoadChainstate & VerifyLoadedChainstate is not well motivated as they don't use warnings or multiple errors, and are thus a better fit for util::Expected",
   "settled_by": null,
   "status": "open",
   "url": "https://github.com/bitcoin/bitcoin/pull/25665#discussion_r2619566751"
  }
 ],
