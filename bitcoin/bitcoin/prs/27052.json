   "harm": "incorrect comparison logic when checking for oldest block announcement timestamp among eviction candidates",
   "hash": "85e5765a008200ab",
   "history": [
    {
     "at": "2026-09-18T03:23:24+00:00",
     "blocking": true,
     "by": "run:20260918-0314",
     "cause": "rc:1352377372",
     "status": "resolved"
    }
   ],
   "id": "rc:1352377372",
   "kind": "correctness",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "This looks wrong to me, i think it should be: if (state->m_last_block_announcement < oldest_block_announcement.value_or(NodeSeconds::max()) || (state->m_last_block_announcement == *oldest_block_announcement && pnode->GetId() > worst_peer))",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2023-10-10",
    "by": "LarryRuane",
    "id": "rc:1353244492",
    "quote": "Thanks, good catch! I force-pushed to fix this in a slightly different way that seems more clear to me."
   },
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/27052#discussion_r1352377372"
  }
 ],
