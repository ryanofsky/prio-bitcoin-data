    }
   ],
   "id": "rc:1276765179",
   "kind": "correctness",
   "pin": null,
   "quote": "Could just as well still be unsupported, not invalid.",
   "settled_by": {
    "at": "2023-07-28",
    "by": "portlandhodl",
    "id": "rc:1277194218",
    "quote": "I have changed this to read Invalid or unsupported prefix... This has been resolved in b66e974ac8f21971602051c08df830d14cf3df7e"
   },
   "status": "resolved",
   "url": "https://github.com/bitcoin/bitcoin/pull/27260#discussion_r1276765179"
