   "harm": "Error message incorrectly stated that address prefixes indicate a chain.",
   "hash": "1b2f5f3e22618d66",
   "history": [
    {
     "at": "2026-09-18T03:24:04+00:00",
     "blocking": true,
     "by": "run:20260918-0314",
     "cause": "rc:1239033958",
     "status": "resolved"
    }
   ],
   "id": "rc:1239033958",
   "kind": "correctness",
   "pin": null,
   "quote": "The prefix does not necessarily indicate a chain. The current error is more correct.",
   "settled_by": {
    "at": "2023-06-23",
    "by": "portlandhodl",
    "id": "rc:1239533282",
    "quote": "This has been resolved by rewording the error message since you are correct addresses have prefixes not chains."
   },
   "status": "resolved",
   "url": "https://github.com/bitcoin/bitcoin/pull/27260#discussion_r1239033958"
  },
