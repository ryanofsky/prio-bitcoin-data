    }
   ],
   "id": "c:4524698348",
   "kind": "correctness",
   "pin": null,
   "quote": "CWallet::RemoveTxs() deletes wallet transactions, but it was not keeping the new TXO caches (m_txos and m_unusable_txos) in sync.",
   "settled_by": {
    "at": "2026-07-01",
    "by": "achow101",
    "id": "c:4860667104",
    "quote": "Checking the states to revert them was starting to get a bit complicated, so I ended up doing the overkill thing of recomputing all of the TXOs after removing any transaction."
   },
   "status": "resolved",
   "url": "https://github.com/bitcoin/bitcoin/pull/27865#issuecomment-4524698348"
  },
