   "harm": "RemoveTxs does not synchronize m_txos and m_unusable_txos cache sets when deleting wallet transactions",
   "hash": "e4c7082b9bb96db6",
   "history": [
    {
     "at": "2026-09-18T03:25:17+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "c:4524698348",
