   "kind": "correctness",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "It seems to me the capnp wrapper needs some updates (missing field, 32/64 bit params, param rename, bool vs uint64, enums as unsigned, optional mapping, unused declarations, comments, etc).",
