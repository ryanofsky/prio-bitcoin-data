   "harm": "batch validation caused significant performance regressions during IBD compared to master",
   "hash": "1b6b46a78d399028",
   "history": [
    {
     "at": "2026-09-18T03:28:51+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "c:2106968575",
     "status": "resolved"
    }
   ],
   "id": "c:2106968575",
   "kind": "approach",
   "pin": null,
   "quote": "master is currently faster... after taproot activation, batch validation is significantly slower than non-batch validation",
   "settled_by": {
    "at": "2025-05-18",
    "by": "fjahr",
    "id": "c:2889288127",
    "quote": "I have implemented this and see a performance boost from it for the case with 15 worker threads"
   },
   "status": "resolved",
   "url": "https://github.com/bitcoin/bitcoin/pull/29491#issuecomment-2106968575"
  },
  {
   "association": "MEMBER",
   "at": "2024-12-07",
   "author": "andrewtoth",
   "author_replies": [
