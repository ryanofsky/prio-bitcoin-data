   ],
   "blocking": false,
   "fix": {
    "at": null,
    "sha": "c4c9aa200d341377fe528de1e30d04fe370c1e09"
   },
   "harm": "holding a shared batch mutex during addition and verifying on the main thread negated multithreading benefits",
   "hash": "9e6dbbbb68558055",
   "history": [
    {
     "at": "2026-09-18T03:28:51+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "c:2525335080",
     "status": "resolved"
    }
   ],
   "id": "c:2525335080",
   "kind": "approach",
   "pin": null,
   "quote": "m_batch_mutex is held for the entirety of adding, which will cause lock contention. Verify is then a blocking call on the main thread, which negates the multithreading.",
   "settled_by": {
    "at": "2025-03-23",
    "by": "fjahr",
    "id": "rc:2009282526",
    "quote": "I have now implemented it with a batch per thread using a flag set in complete as you suggested."
   },
   "status": "resolved",
   "url": "https://github.com/bitcoin/bitcoin/pull/29491#issuecomment-2525335080"
  },
  {
   "association": "MEMBER",
   "at": "2025-03-17",
   "author": "Eunovo",
   "author_replies": [
    "rc:2004525996",
    "rc:2009282526"
   ],
   "blocking": false,
   "fix": {
    "at": null,
    "sha": "c4c9aa200d341377fe528de1e30d04fe370c1e09"
   },
   "harm": "sharing a single batch across threads caused worker threads to block waiting for batch access",
   "hash": "4420d6ea57759572",
   "history": [
    {
     "at": "2026-09-18T03:28:51+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:1997877541",
     "status": "resolved"
    }
   ],
   "id": "rc:1997877541",
   "kind": "approach",
   "pin": null,
   "quote": "All the threads still share this batch. That means we still have the same locking problem; threads will be stuck waiting for the batch to be free.",
   "settled_by": {
    "at": "2025-03-23",
    "by": "fjahr",
    "id": "rc:2009282526",
    "quote": "I have now implemented it with a batch per thread using a flag set in complete as you suggested."
   },
   "status": "resolved",
   "url": "https://github.com/bitcoin/bitcoin/pull/29491#discussion_r1997877541"
  },
  {
   "association": "MEMBER",
   "at": "2025-05-05",
   "author": "Eunovo",
   "author_replies": [
    "c:2889288127"
   ],
   "blocking": false,
   "fix": {
    "at": null,
    "sha": "c4c9aa200d341377fe528de1e30d04fe370c1e09"
   },
   "harm": "performing batch verification inside the critical section caused throughput to degrade as thread count increased",
   "hash": "8ba092f73dce55a9",
   "history": [
    {
     "at": "2026-09-18T03:28:51+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "c:2851542917",
     "status": "resolved"
    }
   ],
   "id": "c:2851542917",
   "kind": "approach",
   "pin": null,
   "quote": "Doing batch-verification work within the critical section",
   "settled_by": {
    "at": "2025-06-12",
    "by": "Eunovo",
    "id": "c:2965616244",
    "quote": "It seems like the major reason for performance drop was the batch-verification work being performed in the critical section."
   },
   "status": "resolved",
   "url": "https://github.com/bitcoin/bitcoin/pull/29491#issuecomment-2851542917"
  },
