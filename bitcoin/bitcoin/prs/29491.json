   },
   "from_schema": 2,
   "harm": "holding a shared batch mutex during addition and verifying on the main thread negated multithreading benefits",
   "hash": "9e6dbbbb68558055",
   "history": [
    {
     "at": "2026-09-18T03:28:51+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "c:2525335080",
     "status": "resolved"
    },
    {
     "at": "2026-10-31T01:17:11+00:00",
     "by": "run:20261031-0114",
     "cause": "rc:2009282526",
     "clears_with": "change",
     "status": "fixed",
     "type": "objection"
    }
   ],
   "id": "c:2525335080",
   "kind": "approach",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "m_batch_mutex is held for the entirety of adding, which will cause lock contention. Verify is then a blocking call on the main thread, which negates the multithreading.",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2025-03-23",
    "by": "fjahr",
    "id": "rc:2009282526",
    "quote": "I have now implemented it with a batch per thread using a flag set in complete as you suggested."
   },
   "status_note": "author implemented per-thread batches verified at the end of block checks",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/29491#issuecomment-2525335080"
  },
  {
   "association": "MEMBER",
   "at": "2025-03-17",
   "author": "Eunovo",
   "author_replies": [
    "rc:2004525996",
    "rc:2009282526"
   ],
   "clears_with": "change",
   "fix": {
    "at": null,
    "sha": "b7d2c11d4d78b7cb183dfac56547d99161d340a0"
   },
   "from_schema": 2,
   "harm": "sharing a single batch across threads caused worker threads to block waiting for batch access",
   "hash": "4420d6ea57759572",
   "history": [
    {
     "at": "2026-09-18T03:28:51+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:1997877541",
     "status": "resolved"
    },
    {
     "at": "2026-10-31T01:17:11+00:00",
     "by": "run:20261031-0114",
     "cause": "rc:2009282526",
     "clears_with": "change",
     "status": "fixed",
     "type": "objection"
    }
   ],
   "id": "rc:1997877541",
   "kind": "approach",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "All the threads still share this batch. That means we still have the same locking problem; threads will be stuck waiting for the batch to be free.",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2025-03-23",
    "by": "fjahr",
    "id": "rc:2009282526",
    "quote": "I have now implemented it with a batch per thread using a flag set in complete as you suggested."
   },
   "status_note": "author implemented per-thread batches",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/29491#discussion_r1997877541"
  },
