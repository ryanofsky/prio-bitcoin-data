   "from_schema": 1,
   "harm": "V2-only gives a false sense of security regarding anonymity and traffic inspection while making peer discovery harder for older v1 nodes.",
   "hash": "fbb2c4739bdbc3bc",
   "history": [
    {
     "at": "2026-09-18T03:32:59+00:00",
     "blocking": true,
     "by": "run:20260918-0314",
     "cause": "c:2388454981",
     "status": "resolved"
    }
   ],
   "id": "c:2388454981",
   "kind": "approach",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "A V2-only option will: not hide the fact that one runs bitcoin node... but it will give the false impression that it does those two things. Further, it will make it more difficult for old nodes to fin",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2025-11-11",
    "by": "vasild",
    "id": "c:3517995745",
    "quote": "with this post I would like to withdraw my \"Concept NACK\" and leave it in your capable hands. Concept 0"
   },
   "status_note": "withdrawn by reviewer after documentation clarifications",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/30951#issuecomment-2388454981"
  },
  {
   "association": "CONTRIBUTOR",
   "at": "2024-11-06",
   "author": "1440000bytes",
   "author_replies": [],
   "clears_with": "change",
   "fix": null,
   "from_schema": 1,
   "harm": "The option and related changes are counterproductive, risk network partitions, and mislead users about node obfuscation.",
   "hash": "7e7b232ddddd4122",
   "history": [
    {
     "at": "2026-09-18T03:32:59+00:00",
     "blocking": true,
