   "author": "gmaxwell",
   "author_replies": [
    "c:5279048438"
   ],
   "clears_with": "change",
   "fix": null,
   "from_schema": 1,
   "harm": "DNS seeds and static address databases do not set the v2 flag, preventing a cold-start node with v2only from finding any peers.",
   "hash": "21051b20feee8052",
   "history": [
    {
     "at": "2026-09-18T03:32:59+00:00",
     "blocking": true,
     "by": "run:20260918-0314",
     "cause": "c:5035178818",
     "status": "resolved"
    }
   ],
   "id": "c:5035178818",
   "kind": "correctness",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "Addresses learned via dnsseed right now as well as the static addr databases don't have the v2 flag. And so a node that has v2 as a requirement for its peer selection won't find any peers at all from ",
   "request": "",
   "status": "answered",
   "status_by": {
    "at": "2026-07-21",
    "by": "mzumsande",
    "id": "c:5036801852",
    "quote": "proposed in #35766, I think it makes sense to change regardless of this PR."
   },
   "status_note": "handled upstream in #35766",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/30951#issuecomment-5035178818"
  }
 ],
