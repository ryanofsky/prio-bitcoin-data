   "from_schema": 1,
   "harm": "Unresolved destination hostnames delegated to a proxy might be clearnet addresses and mistakenly connected via unencrypted v1 transport.",
   "hash": "be34a9fce33f9ffa",
   "history": [
    {
     "at": "2026-09-18T03:32:59+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:3222147684",
     "status": "resolved"
    }
   ],
   "id": "rc:3222147684",
   "kind": "safety",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "When pszDest is unresolved because DNS is delegated to a name proxy, it might be better to treat it as possibly IPv4/IPv6 and block v1 under -v2onlyclearnet.",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2026-05-27",
    "by": "stratospher",
    "id": "c:4554588949",
    "quote": "pushed an update addressing @w0xlt's comments."
   },
   "status_note": "addressed in push",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/30951#discussion_r3222147684"
  },
  {
