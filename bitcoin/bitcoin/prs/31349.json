   "id": "rc:3260950846",
   "kind": "correctness",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "Looks like there is a bug here because `filter` variable is not reset if `ifname` does not begin with \"lo\". Also filter is not declared as a local variable so it will persist between calls.",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2026-06-18",
    "by": "vasild",
    "id": "rc:3435318530",
    "quote": "Done, thanks!"
   },
   "status_note": "Fixed variable resetting and scoping",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/31349#discussion_r3260950846"
  },
