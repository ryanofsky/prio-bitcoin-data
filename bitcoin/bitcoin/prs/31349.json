   ],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "It seems that `--direction` is only enforced at capture time, so it should be moved to the tcpdump call in `traffic_monitor_begin()`. Or maybe just delete here if we don't want to filter there because",
   "request": "",
   "status": "contested",
   "status_by": null,
   "status_note": "ryanofsky agreed the flag is a no-op and suggested dropping or moving it; not yet addressed in code",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/31349#discussion_r3880829694"
  }
