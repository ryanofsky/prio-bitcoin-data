   "harm": "filter variable is not reset for non-loopback interfaces and persists across invocations, which could ignore non-port-53 traffic",
   "hash": "e725dfd76cbff939",
   "history": [
    {
     "at": "2026-09-18T03:35:35+00:00",
     "blocking": false,
