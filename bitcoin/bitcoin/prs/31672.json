   "author": "sipa",
   "author_replies": [],
   "blocking": false,
   "fix": null,
   "harm": "Exposes an un-decayed, non-automated metric directly in production getpeerinfo instead of an experimental RPC with decaying averages",
   "hash": "7eae2d619ba28c26",
   "history": [
    {
     "at": "2026-09-18T03:36:21+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "c:4546559323",
     "status": "open"
    }
   ],
   "id": "c:4546559323",
   "kind": "interface",
   "pin": null,
   "quote": "I'm not sure about making it part of the \"production\" RPC getpeerinfo however... better to create an explicitly experimental \"resource usage dump info\" RPC... Also, I think this should be a decaying average",
   "settled_by": null,
   "status": "open",
   "url": "https://github.com/bitcoin/bitcoin/pull/31672#issuecomment-4546559323"
  },
  {
