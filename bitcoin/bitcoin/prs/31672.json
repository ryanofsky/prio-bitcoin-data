   "pin": null,
   "question": "Why monitor CPU time rather than real time given disk access delays and OS-specific complexity?",
   "quote": "Why monitor cpu time rather than real time? Isn't time spent waiting for disk access while looking up the utxo set equally problematic?",
   "request": "",
   "status": "contested",
   "status_by": {
    "at": "2026-08-11",
    "by": "ajtowns",
    "id": "c:5247453912",
    "quote": "I still think raw-clock-time would be simpler and pretty much equally accurate"
   },
   "status_note": "author defended measuring CPU time; reviewer later reiterated preference for raw-clock time in c:5247453912",
   "type": "question",
   "url": "https://github.com/bitcoin/bitcoin/pull/31672#discussion_r2474923790"
  },
