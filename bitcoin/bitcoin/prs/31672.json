   "id": "c:3128696488",
   "kind": "usefulness",
   "pin": null,
   "quote": "NACK. cpu load alone is a useless metric. However, CPU load divided by TXs accepted into the chain (or mempool) could be a useful metric.",
   "settled_by": null,
   "status": "open",
   "url": "https://github.com/bitcoin/bitcoin/pull/31672#issuecomment-3128696488"
  },
