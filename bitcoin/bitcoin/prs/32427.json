     "type": "objection"
    }
   ],
   "id": "rc:3515739871",
   "kind": "correctness",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "This is a no-op on Windows. I think this can lead to several edge case issues, like the block tree being marked as unpruned when blocks have already been removed, or the WAL not being applied atomical",
   "request": "",
   "status": "answered",
   "status_by": {
    "at": "2026-07-09",
    "by": "sedited",
    "id": "c:4923717652",
    "quote": "Going to convert this to draft for now."
   },
   "status_note": "author converted to draft to address concurrency and storage issues",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/32427#discussion_r3515739871"
  },
