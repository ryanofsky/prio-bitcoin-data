   "harm": "Race between writer creating log_flag.dat and calling ApplyLog allows another process to apply the WAL first, causing the writer to throw an error",
   "hash": "880449ded49607e3",
   "history": [
    {
     "at": "2026-09-25T01:28:37+00:00",
     "by": "run:20260925-0122",
     "cause": "r:4560740333",
     "clears_with": "change",
     "status": "fixed",
     "type": "objection"
    }
   ],
   "id": "r:4560740333",
   "kind": "correctness",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "Since log_flag.dat is visible before the writer enters the final ApplyLog() critical section, another process can observe the completed WAL, apply it, and clear the flag first.",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2026-06-24",
    "by": "sedited",
    "id": "c:4791777117",
    "quote": "Gated lock file flushing behind a read-only flag to avoid the cross-process log file contention issues flagged by @willcl-ark."
   },
   "status_note": "author gated lock file flushing behind read-only flag and introduced OpenMode",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/32427#pullrequestreview-4560740333"
  },
