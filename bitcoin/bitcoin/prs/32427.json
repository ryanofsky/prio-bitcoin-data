   "harm": "Directory committing is a no-op on Windows, potentially breaking flag file atomicity and leading to inconsistencies on power loss",
   "hash": "317026cb1a6bfa68",
   "history": [
    {
     "at": "2026-09-18T03:41:28+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
