   "from_schema": 2,
   "harm": "READ-mode readers could observe stale or partially applied data if a writer crashed leaving an unapplied WAL",
   "hash": "b8e6ea126cda2dc0",
   "history": [
    {
     "at": "2026-09-18T03:41:28+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "r:4647172454",
     "status": "open"
    }
   ],
   "id": "r:4647172454",
   "kind": "approach",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "since READ-mode methods then read the data files directly, a reader could observe stale or partially applied data if log_flag.dat is present from a failed writer. Is that OK in this use-case?",
   "request": "",
   "status": "answered",
   "status_by": {
    "at": "2026-07-09",
    "by": "sedited",
    "id": "c:4923717652",
    "quote": "Going to convert this to draft for now."
   },
   "status_note": "author converted PR to draft to work on non-blocking parallel reader access",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/32427#pullrequestreview-4647172454"
  }
