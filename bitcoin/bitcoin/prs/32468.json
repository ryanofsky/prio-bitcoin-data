    "sha": "1f1c5fd6fa177c71405fa748e8e5c5ee53b73332"
   },
   "harm": "limiting the RPC interface to equal splits rather than supporting custom reward amounts handicaps its usefulness for the sake of CLI convenience",
   "hash": "2f9bab0d1732bd3b",
   "history": [
    {
     "at": "2026-09-18T03:42:07+00:00",
     "blocking": true,
     "by": "run:20260918-0314",
     "cause": "c:4289642909",
     "status": "resolved"
    }
   ],
   "id": "c:4289642909",
   "kind": "interface",
   "pin": null,
   "quote": "Custom rewards are the general solution, why not just implement that right away? It's useful to keep the CLI commands ergonomic, but I think it's a mistake to handicap the RPC interface just to make CLI more ergonomic.",
   "settled_by": {
    "at": "2026-09-16",
    "by": "polespinasa",
    "id": "c:5702616764",
    "quote": "Bicaru20 implemented the custom split rewards."
   },
   "status": "resolved",
   "url": "https://github.com/bitcoin/bitcoin/pull/32468#issuecomment-4289642909"
  }
 ],
