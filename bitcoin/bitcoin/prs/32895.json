   "history": [
    {
     "at": "2026-09-18T03:45:45+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:2941109291",
     "status": "resolved"
    }
   ],
   "id": "rc:2941109291",
   "kind": "correctness",
   "pin": null,
   "quote": "If `WriteLastDecryptedFeatures()` fails, this still updates the in-memory guard, so the write won't be retried on subsequent unlocks.",
   "settled_by": {
    "at": "2026-03-23",
    "by": "achow101",
    "id": "rc:2977816165",
    "quote": "It doesn't matter. The automatic upgrades are no-ops if they've already been done."
   },
   "status": "resolved",
   "url": "https://github.com/bitcoin/bitcoin/pull/32895#discussion_r2941109291"
  },
