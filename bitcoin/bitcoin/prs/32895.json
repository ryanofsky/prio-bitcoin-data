   "id": "rc:3145118367",
   "kind": "approach",
   "pin": null,
   "quote": "seems something of a shame to waste 3/4ths of the available space",
   "settled_by": {
    "at": "2026-04-27",
    "by": "achow101",
    "id": "rc:3149906809",
