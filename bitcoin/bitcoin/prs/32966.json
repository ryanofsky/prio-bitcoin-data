     "status": "resolved"
    }
   ],
   "id": "c:3070838431",
   "kind": "interface",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "it insists on having a bech32 descriptor for change... It seems safer, for backups, to send change to the same silent payment address.",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2025-09-17",
    "by": "Sjors",
    "id": "c:3303689146",
    "quote": "checked that the change went back to the descriptor (there are no other descriptors in the wallet)."
   },
   "status_note": "author updated change destination logic to SP",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/32966#issuecomment-3070838431"
  },
