   "id": "rc:2204657999",
   "kind": "correctness",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "while testing I found that it doesn't disable block filters.",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2025-07-25",
    "by": "Sjors",
    "id": "c:3117880896",
    "quote": "rescan uses the slow version (when `-blockfilterindex` is enabled), as expected"
   },
   "status_note": "rescan logic updated to bypass blockfilter index",
