   "part": 1,
   "pin": null,
   "question": "",
   "quote": "Let's avoid hardcoding the descriptor checksum and instead use the `descsum_create` utility function.",
   "request": "",
   "status": "answered",
   "status_by": null,
   "status_note": "author agreed to fix on next rebase",
