   "harm": "silent payment descriptors cannot be imported into existing wallets because the silent-payments flag cannot be toggled",
   "hash": "630b10a0d282a372",
   "history": [
    {
     "at": "2026-09-18T03:46:30+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "c:3303689146",
     "status": "open"
    }
   ],
   "id": "c:3303689146",
   "kind": "interface",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "It would be nicer if it just toggled the flag; I don't think anyone would accidentally perform such an import - and the flag is immutable via `setwalletflag`.",
   "request": "",
   "status": "answered",
   "status_by": null,
   "status_note": "author replied explaining why flag is immutable; no follow-up from Sjors",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/32966#issuecomment-3303689146"
