   "kind": "safety",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "instead of a generic `CKey::TweakAdd` function that might be abused/footgunny.",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2025-09-18",
    "by": "Eunovo",
    "id": "c:3307718331",
    "quote": "I changed `CKey::TweakAdd()` to `CKey::ComputeBIP352Key()`"
   },
   "status_note": "renamed and scoped tweak functions specifically to BIP352",
