   "harm": "omitting spent_coins in SyncTransaction prevents block-connected transactions from being scanned, leaving mined payments undetected until manual rescan",
   "hash": "c809c47b094032fe",
   "history": [
    {
     "at": "2026-09-19T01:21:01+00:00",
     "blocking": false,
     "by": "run:20260919-0120",
     "cause": "rc:4050728072",
     "status": "open"
    }
   ],
   "id": "rc:4050728072",
   "kind": "correctness",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "spent_coins is built here but not passed to SyncTransaction, and IsMine gates silent payment scanning on !spent_coins.empty(), so block-connected transactions are never scanned.",
   "request": "",
   "status": "answered",
   "status_by": null,
   "status_note": "author agreed to fix on next rebase",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/32966#discussion_r4050728072"
  }
