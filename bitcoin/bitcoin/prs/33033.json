   "from_schema": 1,
   "harm": "unconditionally initializing all statement objects upfront in short-lived batches adds unnecessary overhead and complexity",
   "hash": "dd53ede4661830d7",
   "history": [
    {
     "at": "2026-09-18T03:48:26+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:2646362930",
     "status": "resolved"
    }
   ],
   "id": "rc:2646362930",
   "kind": "maintenance",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "I think it would be cheaper and less complicated to initialize statement objects just before they are used in the various `Read*()` `Erase*()` , and it takes better advantage of the fact that statements are RAII",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2026-01-02",
    "by": "achow101",
    "id": "rc:2658468710",
    "quote": "However, we can construct the `SQLiteStatement` on first use instead of always, so I've added a commit to do that."
   },
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/33033#discussion_r2646362930"
  },
  {
   "association": "MEMBER",
   "at": "2026-07-24",
   "author": "Eunovo",
   "author_replies": [
