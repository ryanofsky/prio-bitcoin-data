   "harm": "ignoring sqlite3_finalize return values in the destructor prevents signaling errors to callers",
   "hash": "783e8ca46e48b56d",
   "history": [
    {
     "at": "2026-09-18T03:48:26+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:2518767761",
     "status": "resolved"
    }
   ],
   "id": "rc:2518767761",
   "kind": "correctness",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "Some of the callers of `sqlite3_finalize()` used to check its return value. Here in the destructor it is too late to signal an error to the caller... Ignoring the return value does not look good.",
   "request": "",
   "status": "accepted",
   "status_by": {
    "at": "2025-11-20",
    "by": "vasild",
    "id": "r:3487577017",
    "quote": "ACK 0af7c2a11819a21e11abf34b4229c5c21150d827"
   },
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/33033#discussion_r2518767761"
  },
