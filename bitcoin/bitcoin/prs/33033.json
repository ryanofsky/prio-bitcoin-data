   },
   "from_schema": 1,
   "harm": "sqlite3_column_text can return nullptr, potentially causing undefined behavior when constructing a string without a null check",
   "hash": "9d98602292fb19ce",
   "history": [
    {
     "at": "2026-09-18T03:48:26+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:2518594590",
     "status": "resolved"
    }
   ],
   "id": "rc:2518594590",
   "kind": "safety",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "`sqlite3_column_text()` can return `nullptr`, better check that. The previous caller did check",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2025-11-17",
    "by": "achow101",
    "id": "rc:2535566375",
    "quote": "Done, returns an empty string now."
   },
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/33033#discussion_r2518594590"
  },
