   ],
   "clears_with": "answer",
   "fix": null,
   "from_schema": 1,
   "harm": "uncompiled trailing SQL is silently ignored when multiple statements are passed to sqlite3_prepare_v2 without checking pzTail",
   "hash": "0c89ad4ccc3094a1",
