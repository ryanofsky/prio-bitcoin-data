   "id": "rc:3883522238",
   "kind": "approach",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "What is the intended wallet layout for a multisig where one cosigner is an external signer and another is a hot key, if mixing hot and cold descriptors in one wallet is discouraged?",
   "quote": "If mixing hot and cold in one wallet isn't encouraged, what's the intended layout for a multisig where one cosigner is an external signer and another is a hot key, one wallet per key?",
   "request": "",
   "status": "answered",
   "status_by": {
    "at": "2026-08-31",
    "by": "Sjors",
    "id": "rc:3893028331",
    "quote": "Ideally there's a single multisig descriptor for which the wallet has one key, e.g. musig2(core_xprv, ledger_xpub)."
   },
   "status_note": "author explained the descriptor setup and key export workflow",
   "type": "question",
   "url": "https://github.com/bitcoin/bitcoin/pull/33112#discussion_r3883522238"
  }
 ],
