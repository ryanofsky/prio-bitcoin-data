   "harm": "In an external signer wallet with private keys enabled, FillPSBT attempts to sign hot key UTXOs using the hardware signer and fails.",
   "hash": "941b169574fa32f3",
   "history": [
    {
     "at": "2026-09-18T03:49:52+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:3876752265",
