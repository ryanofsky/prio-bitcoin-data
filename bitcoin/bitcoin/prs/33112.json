     "cause": "rc:3883522238",
     "clears_with": "change",
     "status": "accepted",
     "type": "objection"
    }
   ],
   "id": "rc:3876752265",
   "kind": "correctness",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "a descriptor holding a hot key also gets an ExternalSignerScriptPubKeyMan here, and at LoadDescriptorScriptPubKeyMan. Its FillPSBT() goes straight to the device when sign=true and never falls back.",
   "request": "",
   "status": "accepted",
   "status_by": {
    "at": "2026-08-28",
    "by": "PraneethGunas",
    "id": "rc:3883522238",
    "quote": "Confirmed fixed on a Ledger Flex, thanks."
   },
   "status_note": "reviewer confirmed the fix on Ledger Flex",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/33112#discussion_r3876752265"
  },
