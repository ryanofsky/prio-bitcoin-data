   "id": "rc:2260589218",
   "kind": "approach",
   "pin": null,
   "quote": "We are now trying to add 200+ lines of code to this repo which have to be maintained, but they cause label spam, and likely aren't sufficient to achieve the goal, because the ci-failed notification will go to the one adding the label and triggering the workflow?",
   "settled_by": {
    "at": "2026-05-06",
    "by": "maflcko",
    "id": "r:4234158318",
    "quote": "lgtm, thx!"
   },
   "status": "resolved",
   "url": "https://github.com/bitcoin/bitcoin/pull/33145#discussion_r2260589218"
