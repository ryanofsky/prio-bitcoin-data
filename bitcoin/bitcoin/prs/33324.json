   "kind": "safety",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "It does feel a bit weird to me to assert on what is not an invariant of the program, but rather an exceptional condition. Why not just throw or return here",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2026-07-25",
    "by": "l0rinc",
    "id": "rc:3649809000",
    "quote": "filesystem failures now propagate instead of aborting on assertions."
   },
   "status_note": "",
