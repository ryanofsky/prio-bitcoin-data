   "id": "rc:2476651745",
   "kind": "maintenance",
   "pin": null,
   "quote": "Please don't encode default values in how the code is written. This makes it impossible to change the default values without rewriting the code logic.",
   "settled_by": {
    "at": "2025-10-31",
    "by": "polespinasa",
    "id": "rc:2482397743",
    "quote": "Thanks for the suggestion, yep it is cleaner. Now should be as easy as changing the default in the arg definition."
   },
   "status": "resolved",
   "url": "https://github.com/bitcoin/bitcoin/pull/33741#discussion_r2476651745"
