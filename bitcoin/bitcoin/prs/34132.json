   "harm": "Swallowing deserialization exceptions or catching them without aborting leaves the program continuing despite storage corruption or severe logic bugs.",
   "hash": "4427ca306f783120",
   "history": [
    {
     "at": "2026-09-18T04:04:01+00:00",
     "blocking": true,
     "by": "run:20260918-0314",
