   "part": 1,
   "pin": null,
   "question": "",
   "quote": "doing that on a corrupt index seems a bit more questionable -- if the txindex or blockfilter or coinstats indexes fail, I could see it being better",
   "request": "",
   "status": "contested",
   "status_by": {
    "at": "2026-08-24",
    "by": "ajtowns",
    "id": "rc:3841273714",
    "quote": "If I'm running a node in order to receive funds via lightning or btcpayserver and enabled an index because I thought it would be fun or help the network, then bugs in that index taking my shop down entirely would be very annoying."
   },
   "status_note": "ajtowns pushed back against taking down operating nodes on optional index corruption; author maintained fatal behavior in c:5643408398 and proposed IRC discussion",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/34132#discussion_r3840870813"
