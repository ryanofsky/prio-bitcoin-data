   "part": 1,
   "pin": null,
   "question": "Why does the coinsdb read error test fail without IPC on 32-bit systems?",
   "quote": "Do we know why?",
   "request": "",
   "status": "answered",
   "status_by": {
    "at": "2026-01-11",
    "by": "l0rinc",
    "id": "rc:2679121949",
    "quote": "The trick was that on 64-bit systems, LevelDB uses mmap which reflects file changes immediately - this is what we we're used to. But on 32-bit systems (i686, armhf), mmap is disabled"
   },
   "status_note": "author investigated and explained LevelDB disables mmap on 32-bit architectures, causing stale block cache reads",
   "type": "question",
   "url": "https://github.com/bitcoin/bitcoin/pull/34132#discussion_r2659845168"
  },
  {
   "association": "MEMBER",
   "at": "2026-01-11",
   "author": "andrewtoth",
   "author_replies": [
    "rc:2680107724"
   ],
   "clears_with": "answer",
   "fix": null,
   "from_schema": 2,
