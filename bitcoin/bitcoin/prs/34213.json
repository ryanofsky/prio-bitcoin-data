   "from_schema": 1,
   "harm": "Anchors saved on network deactivation were not capped to the oldest peers, allowing a newly added block-relay peer to displace older anchors.",
   "hash": "da93763124236334",
   "history": [
    {
     "at": "2026-09-18T04:06:11+00:00",
