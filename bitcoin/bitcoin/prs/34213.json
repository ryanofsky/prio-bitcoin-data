   "id": "rc:3985494910",
   "kind": "correctness",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "GetCurrentBlockRelayOnlyConns() returns peers in connection order, while ThreadOpenConnections() consumes anchors from the back... Including a temporary third peer therefore lets it take the oldest anchor\u2019s place after a network toggle.",
   "request": "",
   "status": "fixed",
