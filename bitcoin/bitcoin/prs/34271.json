   "from_schema": 1,
   "harm": "std::optional preserves inline storage for PrivateBroadcast inside PeerManagerImpl and does not reduce object size without indirection",
   "hash": "1b16f07fb1df0ff1",
   "history": [
    {
     "at": "2026-09-18T04:08:52+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:3249558447",
     "status": "open"
    }
   ],
   "id": "rc:3249558447",
   "kind": "approach",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "Note that this still reserves storage for a PrivateBroadcast inside every PeerManagerImpl, even when private broadcast is disabled. This only skips construction and active state - avoiding the object-size footprint too would require indirection",
   "request": "",
   "status": "open",
   "status_by": null,
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/34271#discussion_r3249558447"
