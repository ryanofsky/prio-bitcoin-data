   "harm": "sharing a global threadpool across wallets could let a rescan controller thread process tasks from another wallet's RPC, distorting latency",
   "hash": "4084bd04532afcee",
   "history": [
    {
     "at": "2026-09-18T04:14:13+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:2940686723",
     "status": "resolved"
    }
   ],
   "id": "rc:2940686723",
   "kind": "correctness",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "Can't it happen that this controller thread picks up the task of another RPC of another wallet, thereby distorting results (from a RPC latency point of view) of this one?",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2026-04-14",
    "by": "Eunovo",
    "id": "rc:3079577515",
    "quote": "I have moved away from a shared ThreadPool to one that is initialized before scanning and discarded after."
   },
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/34400#discussion_r2940686723"
  }
