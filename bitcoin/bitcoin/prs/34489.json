   "harm": "Early return in ProcessBlocks bypassed interrupt handling, skipping the expected recovery and commit path",
   "hash": "27908f72124a1105",
   "history": [
    {
     "at": "2026-09-18T03:25:13+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:2807338683",
     "status": "resolved"
    }
   ],
   "id": "rc:2807338683",
   "kind": "correctness",
   "pin": null,
   "quote": "Returning `false` here causes the interrupt to be handled incorrectly... As a result, the expected recovery path is skipped.",
   "settled_by": {
    "at": "2026-02-14",
    "by": "furszy",
    "id": "rc:2807692937",
    "quote": "Nice catch. Pushed an update that fixes it and adds test coverage."
   },
   "status": "resolved",
   "url": "https://github.com/bitcoin/bitcoin/pull/34489#discussion_r2807338683"
