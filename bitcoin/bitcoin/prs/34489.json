     "cause": "rc:2906884044",
     "status": "open"
    }
   ],
   "id": "rc:2906884044",
   "kind": "correctness",
   "pin": null,
   "quote": "We seem to be writing to disk to eagerly here, this also is misaligned with the batching.",
   "settled_by": null,
   "status": "open",
