   "harm": "Unbounded backward loop in ProcessBlocks could loop infinitely or crash past genesis if start and end heights are invalid or on different forks",
   "hash": "96c13d3e64fbabb2",
   "history": [
    {
     "at": "2026-09-18T03:25:13+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:2905545389",
     "status": "open"
    }
   ],
   "id": "rc:2905545389",
   "kind": "safety",
   "pin": null,
   "quote": "Given how intertwined the code is here, a serious mess-up could cause an infinite loop and would be really hard to trace back to the source.",
   "settled_by": null,
   "status": "open",
   "url": "https://github.com/bitcoin/bitcoin/pull/34489#discussion_r2905545389"
  },
  {
   "association": "CONTRIBUTOR",
