   "pin": null,
   "question": "Why keep ProcessBlock around instead of handling one or many blocks in one function?",
   "quote": "Why keep `ProcessBlock` around? It should be simpler if we just have one function and it can be handed one or many blocks.",
   "request": "",
   "status": "answered",
   "status_by": {
    "at": "2026-02-03",
    "by": "furszy",
    "id": "rc:2759661644",
    "quote": "Because `ProcessBlocks` will be specialized in a follow-up commit (please see #26966) to enable additional speedups"
   },
   "status_note": "author explained specialization plans for parallelization in rc:2759661644",
   "type": "question",
   "url": "https://github.com/bitcoin/bitcoin/pull/34489#discussion_r2758171790"
  },
