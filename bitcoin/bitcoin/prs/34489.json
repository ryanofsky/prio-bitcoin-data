   "author": "l0rinc",
   "author_replies": [],
   "blocking": false,
   "fix": null,
   "harm": "BlockFilterIndex writes flat files to disk eagerly per block, which is misaligned with LevelDB batching and risks orphaned flat file data on interrupt",
   "hash": "ce5a06a9cfc3ffb1",
   "history": [
    {
     "at": "2026-09-18T03:25:13+00:00",
     "blocking": false,
