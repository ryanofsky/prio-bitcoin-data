   "harm": "Removing final from BlockFilterIndex weakens class encapsulation solely to allow test subclassing",
   "hash": "13fd72520a559044",
   "history": [
    {
     "at": "2026-09-18T03:25:13+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:2884888266",
