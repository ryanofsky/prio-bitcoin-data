    "sha": "fa0e12e77bb90bef05bfd8a960e1a28673b575be"
   },
   "harm": "direct-initialization of non-const lvalues selects the forwarding constructor over the copy constructor, triggering an unnecessary assertion and divergence on moved-from objects",
   "hash": "08299e008ec98a91",
   "history": [
    {
     "at": "2026-09-18T03:27:11+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:3631508842",
     "status": "resolved"
    }
   ],
   "id": "rc:3631508842",
   "kind": "correctness",
   "pin": null,
   "quote": "For a non-const lvalue NotNull<T> under direct-init, the forwarding ctor is selected instead of the copy ctor.",
