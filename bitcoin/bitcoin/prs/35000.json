   "harm": "test bailout check using logical AND instead of OR risks bad_optional_access if only one AddCoin call fails",
   "hash": "54a5cc938e8a40f6",
   "history": [
    {
     "at": "2026-09-18T03:29:07+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:3046803139",
     "status": "resolved"
    }
   ],
   "id": "rc:3046803139",
   "kind": "correctness",
   "pin": null,
   "quote": "This uses `&&` so it only bails if both `AddCoin` calls fail. If just one fails you get a `bad_optional_access` from `.value()`.",
   "settled_by": {
    "at": "2026-04-07",
    "by": "ismaelsadeeq",
    "id": "c:4201614356",
    "quote": "Fixed https://github.com/bitcoin/bitcoin/pull/35000#discussion_r3046803139"
   },
   "status": "resolved",
