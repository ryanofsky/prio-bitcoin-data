   "harm": "scanning a transaction with an invalid x-only pubkey could trigger a crash",
   "hash": "110c1f12d05f8d75",
   "history": [
    {
     "at": "2026-09-18T03:30:32+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:3256003872",
