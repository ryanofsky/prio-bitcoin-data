   "clears_with": "answer",
   "fix": null,
   "from_schema": 2,
   "harm": "making silent payments transactions non-replaceable on older software leaves the wallet UI in an opaque and confusing state during fee bumping; older versions should fail loudly with a wallet flag instead",
