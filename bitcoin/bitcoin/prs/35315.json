   "fix": null,
   "harm": "Relying on time_point::min and time_point::max sentinels creates nonsensical time values and obscures semantic states compared to std::optional",
   "hash": "9781a155fa83d6ba",
   "history": [
    {
     "at": "2026-09-18T03:31:07+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:3617453960",
     "status": "resolved"
    }
   ],
   "id": "rc:3617453960",
   "kind": "interface",
   "pin": null,
   "quote": "I find relying on sentinels (`if (State(staller)->m_stalling_since == NodeClock::time_point::max())`) to be an antipattern, and would have found it more clear if this were a `std::optional`.",
   "settled_by": {
    "at": "2026-07-22",
    "by": "stickies-v",
    "id": "rc:3629582365",
    "quote": "I'm happy to keep it as-is, it's not a regression vs master and the PR has too many other benefits to be spending too much time/energy on this rather small issue."
   },
   "status": "resolved",
   "url": "https://github.com/bitcoin/bitcoin/pull/35315#discussion_r3617453960"
  }
