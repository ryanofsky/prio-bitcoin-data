   "pin": null,
   "question": "",
   "quote": "Could have two timers associated with the request so that as well as tracking when the peer was parked, we only do retries of parked peers when it's been 100ms or so since the last retry.",
   "request": "Consider adding a retry timer to only retry parked peers when ~100ms has elapsed to avoid blocking message processing if cs_main is held",
   "status": "fixed",
   "status_by": {
    "at": "2026-11-05",
    "by": "randomlogin",
    "id": "rc:4475640817",
    "quote": "Added `last_retry_time` and `PARKED_CF_RETRY_INTERVAL=100ms`, now we don't retry if the previous attempt was too recent."
   },
   "status_note": "added last_retry_time and 100ms retry interval",
   "type": "suggestion",
