   "clears_with": "answer",
   "fix": null,
   "harm": "requiring users to manage clock time across multiple separate places is cumbersome and error-prone",
   "hash": "68322523366c4312",
   "history": [
    {
     "at": "2026-09-18T03:33:41+00:00",
     "blocking": false,
