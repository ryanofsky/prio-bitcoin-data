   "harm": "direct GetMockTime call in tx_pool test can silently cause bugs if mocktime is unset, bypasses the system time sanitizer, and returns a duration instead of a time point",
   "hash": "bbe0688e1cc73814",
   "history": [
    {
     "at": "2026-09-18T03:33:41+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:3436545216",
     "status": "resolved"
    }
   ],
   "id": "rc:3436545216",
   "kind": "correctness",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "the call to GetMockTime here looks wrong for several reasons: It directly access the test-only global of the mock time, which may be 0, and thus may lead to silent bugs if mocktime was not used here? It side-steps the g_used_system_time runtime sanitizer.",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2026-06-18",
    "by": "ryanofsky",
    "id": "rc:3438787890",
    "quote": "Makes sense, switched GetMockTime() -> Now()"
   },
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/35557#discussion_r3436545216"
  },
