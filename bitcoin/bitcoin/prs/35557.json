   "id": "c:4780411600",
   "kind": "interface",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "This could get a bit annoying and potentially dangerous when users need to start managing clocks across multiple places.",
   "request": "",
   "status": "answered",
   "status_by": {
    "at": "2026-06-29",
    "by": "ryanofsky",
    "id": "r:4588310492",
    "quote": "My instinct is that it doesn't because if you're creating multiple chainstate managers or other objects that accept times, and your application needs artificial times instead of the current clock time, I wouldn't assume that multiple objects would want to have the same time set."
   },
   "status_note": "",
