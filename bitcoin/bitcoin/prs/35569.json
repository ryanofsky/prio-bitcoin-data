   "history": [
    {
     "at": "2026-09-18T03:33:58+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:3480528778",
     "status": "resolved"
    }
   ],
   "id": "rc:3480528778",
   "kind": "safety",
   "other_replies": [],
   "pin": null,
   "quote": "In any case, I think `LIFETIMEBOUND` could be added here?",
