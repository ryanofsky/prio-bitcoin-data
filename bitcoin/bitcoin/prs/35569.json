   "at": "2026-06-26",
   "author": "maflcko",
   "author_replies": [
    "c:4810859037"
   ],
   "blocking": false,
   "fix": {
    "at": null,
    "sha": "402500baad826efff3dbe52c75694d93121e1b06"
   },
   "harm": "Accessor methods returning references without LIFETIMEBOUND attribute can lead to dangling reference bugs.",
