   "blocking": false,
   "fix": null,
   "harm": "Renaming well-established protocol-level names like vin and vout to GetInputs and GetOutputs creates confusion between internal Core code and external RPC/protocol terms.",
   "hash": "80876981bd87bfad",
   "history": [
    {
     "at": "2026-09-18T03:33:58+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "r:4621058158",
     "status": "open"
    }
   ],
   "id": "r:4621058158",
   "kind": "interface",
   "other_replies": [],
   "pin": null,
   "quote": "On a language level, terms such as vin, vout etc. have long become part of the public protocol: For example encapsulating vin through GetInputs() internally within bitcoin core, just to expose them as",
   "settled_by": null,
   "status": "open",
   "url": "https://github.com/bitcoin/bitcoin/pull/35569#pullrequestreview-4621058158"
  },
  {
   "after_reply": "likely_settled",
