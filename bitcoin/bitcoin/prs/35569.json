   "kind": "safety",
   "other_replies": [],
   "pin": null,
   "quote": "I think it is nice to have minimally more compiler checks to enforce initialization, also to keep the code as-is for now, and only change this in the future, when there is a real need or real observable benefit.",
   "settled_by": null,
   "status": "open",
   "url": "https://github.com/bitcoin/bitcoin/pull/35569#issuecomment-5729309589"
