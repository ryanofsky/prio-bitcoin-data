   "id": "r:4621677109",
   "kind": "approach",
   "other_replies": [],
   "pin": null,
   "quote": "Approach NACK for now. I don't see a concrete benefit here that justifies rewriting so many transaction call sites in consensus, policy, mempool, wallet, tests, fuzzers, and kernel-facing code.",
   "settled_by": null,
   "status": "open",
   "url": "https://github.com/bitcoin/bitcoin/pull/35569#pullrequestreview-4621677109"
