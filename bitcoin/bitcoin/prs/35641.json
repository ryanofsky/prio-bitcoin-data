   "harm": "test suite fails when compiled with ENABLE_SCRIPT_TRACE=ON due to callback pushing into destroyed vector in subsequent tests",
   "hash": "d26a0033be2eafb6",
   "history": [
    {
     "at": "2026-09-18T03:35:08+00:00",
     "blocking": true,
     "by": "run:20260918-0314",
