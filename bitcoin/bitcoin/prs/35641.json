     "status": "resolved"
    }
   ],
   "id": "rc:3893679920",
   "kind": "correctness",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "Add ScriptTraceUnsetCallback() to avoid the next test case push into a destroyed vector. Test suite currently does not pass with the feature flag.",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2026-08-31",
    "by": "sedited",
    "id": "c:5480776417",
    "quote": "unsetting the callback after the trace tests are complete."
   },
   "status_note": "",
   "type": "objection",
