   },
   "harm": "null error pointer causes successful evaluation to report SCRIPT_ERR_UNKNOWN_ERROR in trace end frames",
   "hash": "9d609d17f86686a4",
   "history": [
    {
     "at": "2026-09-18T03:35:08+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:3758299224",
     "status": "resolved"
    }
   ],
   "id": "rc:3758299224",
   "kind": "correctness",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "a null m_error makes a successful eval report SCRIPT_ERR_UNKNOWN_ERROR. The kernel path always passes &error, but in case any non-kernel callers want to use the tracer, would it make sense to assert it in the ctor?",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2026-08-28",
    "by": "sedited",
    "id": "c:5457530691",
    "quote": "added the suggested assertion for passing in the error."
   },
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/35641#discussion_r3758299224"
  },
  {
   "association": "MEMBER",
