   "harm": "EvalScript triggers an assertion failure when tracing is enabled if called with a null serror pointer (e.g. in CheckSignetBlockSolution)",
   "hash": "ca4953637b653f88",
   "history": [
    {
     "at": "2026-09-18T03:35:08+00:00",
     "blocking": true,
     "by": "run:20260918-0314",
     "cause": "c:5499409957",
     "status": "open"
    }
   ],
   "id": "c:5499409957",
   "kind": "correctness",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "The tracing code assumes serror is non-null whenever a callback is registered, but EvalScript permits nullptr... This triggers the assertion assert(!m_callback || error);",
   "request": "",
   "status": "open",
   "status_by": null,
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/35641#issuecomment-5499409957"
