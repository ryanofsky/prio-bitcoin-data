   "author": "w0xlt",
   "author_replies": [],
   "clears_with": "answer",
   "fix": null,
   "harm": "oversized scripts are rejected before ScriptTraceScope is instantiated, preventing BEGIN and END trace frames from being emitted",
   "hash": "cd0f23792d16bab0",
   "history": [
    {
     "at": "2026-09-18T03:35:08+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "c:5499715130",
     "status": "open"
    }
   ],
   "id": "c:5499715130",
   "kind": "correctness",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "EvalScript rejects oversized scripts before constructing ScriptTraceScope, so a registered callback receives neither BEGIN nor END.",
   "request": "",
   "status": "open",
   "status_by": null,
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/35641#issuecomment-5499715130"
  }
