   "harm": "BOOST_CHECK_EQUAL on vector size allows test execution to continue and access out-of-bounds indices, causing undefined behavior",
   "hash": "3c06b00fa3441c58",
   "history": [
    {
     "at": "2026-09-18T03:35:08+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:3675592714",
     "status": "resolved"
    }
   ],
   "id": "rc:3675592714",
   "kind": "safety",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "BOOST_CHECK_EQUAL(states.size(), 11) is non-fatal, but the test checks states[0] through states[10] after this. So if the size check fails, the test still continues and may access out-of-bound items, resulting in an undefined behavior",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2026-08-28",
    "by": "sedited",
    "id": "c:5457530691",
    "quote": "made the boost size check a hard requirement."
   },
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/35641#discussion_r3675592714"
  },
  {
   "association": "CONTRIBUTOR",
   "at": "2026-08-11",
   "author": "stringintech",
   "author_replies": [
