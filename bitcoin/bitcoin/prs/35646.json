   "harm": "Separating errors causes inconsistent RPC error mapping and redundant complexity if errors are immediately flattened back down to booleans.",
   "hash": "b59e59b672880520",
   "history": [
    {
     "at": "2026-09-18T03:35:07+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "c:4912465662",
     "status": "resolved"
    }
   ],
   "id": "c:4912465662",
   "kind": "interface",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "Either we can distinguish the two cases clearly, in which case a separate type and handling makes sense (and they shouldn't be flattened down). Or, we can not distinguish them, in which case splitting",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2026-07-16",
    "by": "yuvicc",
    "id": "c:4988444254",
    "quote": "Fatal/system failures are now represented separately as kernel::FatalError and propagated via util::Expected, while Bloc"
   },
   "status_note": "settled by introduction of kernel::FatalError type",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/35646#issuecomment-4912465662"
  },
  {
   "association": "CONTRIBUTOR",
