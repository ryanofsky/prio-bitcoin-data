   "harm": "BOOST_TEST_RANDOM is treated as a boolean without parsing the seed value or logging the used seed, making test run ordering non-reproducible.",
   "hash": "0595ae033af3c7e4",
   "history": [
    {
     "at": "2026-09-18T03:35:36+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:3890390082",
     "status": "resolved"
    }
   ],
   "id": "rc:3890390082",
   "kind": "correctness",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "Here the value is only checked for presence, never read, so 0 and an empty string both turn shuffling on and a fixed seed no longer reproduces.",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2026-09-10",
    "by": "rustaceanrob",
    "id": "rc:3978594424",
    "quote": "Fixed by using a random seed and printing it if equal to 1, and setting the seed directly if > 1."
   },
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/35713#discussion_r3890390082"
  },
