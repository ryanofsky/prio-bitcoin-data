   "id": "c:5084823870",
   "kind": "safety",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "Since we now take a shared lock while inside a separate lock which is released while the shared lock continues to be held, it would require us to make a modification to make sure we're popping the correct lock being released. This would let us catch issues with DEBUG_LOCKORDER.",
   "request": "",
   "status": "fixed",
