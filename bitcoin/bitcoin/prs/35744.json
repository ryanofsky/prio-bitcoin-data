   "harm": "DEBUG_LOCKORDER cannot handle non-LIFO lock releases when long-lived shared locks outlive outer locks",
   "hash": "e49112c56957e411",
   "history": [
    {
     "at": "2026-09-18T03:36:56+00:00",
