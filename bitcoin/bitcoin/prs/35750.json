   "from_schema": 1,
   "harm": "Addresses on an unreachable network could stay indefinitely in addrman without eviction if gossip repeatedly refreshes their timestamps",
   "hash": "042e49f67a2cde12",
   "history": [
    {
     "at": "2026-09-18T03:36:54+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "c:5102633395",
     "status": "resolved"
    }
   ],
   "id": "c:5102633395",
   "kind": "approach",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "suppose ipv6 stays unreachable and we keep receiving ipv6 gossip (timestamps refresh) - then these addresses would stay indefinitely in the addrman (and won't be evicted unless they have nRefCount > 1) and are kind of useless to us till the connectivity issue is fixed.",
   "request": "",
   "status": "answered",
   "status_by": {
    "at": "2026-08-12",
    "by": "mzumsande",
    "id": "c:5267180693",
    "quote": "Good point, at the end of the day I think we'd have to live with that. If the user knows that they will not be able to reach IPv6 permanently, they would best specify that we `-onlynet=ipv4`."
   },
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/35750#issuecomment-5102633395"
  }
 ],
