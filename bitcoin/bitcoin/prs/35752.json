   },
   "from_schema": 1,
   "harm": "read errors in Exists() silently skip plaintext key erasure and leave behind an unreadable, corrupted wallet",
   "hash": "74ea3ad414359e17",
   "history": [
    {
     "at": "2026-09-18T03:37:46+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:3838786112",
     "status": "resolved"
    }
   ],
   "id": "rc:3838786112",
   "kind": "correctness",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "If `Exists` hits a read error it's indistinguishable from \"not found\", since `HasKey` is just `res == SQLITE_ROW`, and the erase gets skipped silently.",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2026-09-15",
    "by": "l0rinc",
    "id": "c:5676331884",
    "quote": "Encrypted-key writes now always attempt the plaintext erase after a successful write and use a transaction when the caller has none, so erase or commit failures leave insertion retryable."
   },
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/35752#discussion_r3838786112"
  }
 ],
