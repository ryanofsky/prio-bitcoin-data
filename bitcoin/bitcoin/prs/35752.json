   "harm": "failing to restore the lock state immediately after validating the passphrase leaves a previously locked wallet unlocked if re-encryption fails",
   "hash": "3bc620f4c50a07e5",
   "history": [
    {
     "at": "2026-09-18T03:37:46+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "rc:3817130046",
     "status": "resolved"
    }
   ],
   "id": "rc:3817130046",
   "kind": "correctness",
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "Behavior change, but this should really happen right after the `Unlock` at the top of this `if`. Otherwise, if we are unable to encrypt the master key with the new passphrase for whatever reason, the wallet will be locked if it was locked.",
   "request": "",
   "status": "fixed",
   "status_by": {
    "at": "2026-08-20",
    "by": "achow101",
    "id": "c:5360998812",
