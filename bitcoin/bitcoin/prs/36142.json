   "harm": "Character blacklisting is brittle compared to strictly validating expected base64 characters for KeyBlob",
   "hash": "e889e09bc4ca6600",
   "history": [
    {
     "at": "2026-09-18T03:45:29+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "c:5526250741",
     "status": "resolved"
    }
   ],
   "id": "c:5526250741",
   "kind": "approach",
   "pin": null,
   "quote": "Instead of chasing bad characters from the Tor router reponses, it would be more robust to only allow legit characters and frown upon anything else.",
   "settled_by": {
    "at": "2026-09-04",
    "by": "l0rinc",
    "id": "c:5545894123",
    "quote": "addressed all comments, thank you! ... and @vasild for suggesting strict key-format and service-ID validation."
   },
   "status": "resolved",
   "url": "https://github.com/bitcoin/bitcoin/pull/36142#issuecomment-5526250741"
  },
  {
