    "sha": "668335829636c3d9aa44f60a0b595cfefd201340"
   },
   "harm": "Malformed ServiceID in Tor daemon reply is passed unchecked to LookupNumeric() and LogInfo() instead of aborting",
   "hash": "d61fd1a9d30bd0e9",
   "history": [
    {
     "at": "2026-09-18T03:45:29+00:00",
     "blocking": false,
     "by": "run:20260918-0314",
     "cause": "c:5543733038",
     "status": "resolved"
    }
   ],
   "id": "c:5543733038",
   "kind": "safety",
   "pin": null,
   "quote": "But it must be exactly 56 base32 characters. If it is not, then it is safer to assume malformed reply from Tor, stop the processing right there, and not pass the malformed stuff to other functions.",
   "settled_by": {
    "at": "2026-09-04",
    "by": "l0rinc",
    "id": "c:5545894123",
    "quote": "Service IDs are validated before caching the key or advertising the service"
   },
   "status": "resolved",
   "url": "https://github.com/bitcoin/bitcoin/pull/36142#issuecomment-5543733038"
  },
