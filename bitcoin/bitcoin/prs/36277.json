   "harm": "transactions are kept in memory indefinitely until node restart or maximum limit, increasing resource usage",
   "hash": "e3da1e0842ec1629",
   "history": [
    {
     "at": "2026-09-22T01:16:33+00:00",
     "blocking": false,
     "by": "run:20260922-0113",
     "cause": "rc:4066000330",
     "status": "open"
    }
