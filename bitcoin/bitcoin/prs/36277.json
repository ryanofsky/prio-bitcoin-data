    }
   ],
   "id": "rc:4065921818",
   "kind": "maintenance",
   "other_replies": [],
   "pin": null,
   "quote": "Now the retry is basically dead code, since it will take a long time until 1000 resend attempts are reached - I think it might as well be removed.",
   "settled_by": null,
   "status": "open",
   "url": "https://github.com/bitcoin/bitcoin/pull/36277#discussion_r4065921818"
  },
