   "part": 1,
   "pin": null,
   "question": "",
   "quote": "Might it be preferable to make m_block_template non-mutating? Do users of the interface even need the mutated template after submitting?",
   "request": "Make m_block_template non-mutating/const instead of protecting it with a mutex",
   "status": "answered",
   "status_by": {
    "at": "2026-10-21",
    "by": "ismaelsadeeq",
    "id": "c:6313711072",
    "quote": "AFAICT no, so we could do that and make the template const, that way no race and we copy when mutating for submission."
   },
   "status_note": "ismaelsadeeq and w0xlt supported the idea, noting it avoids the race without mutex locking but affects sv2-tp and existing tests",
   "type": "suggestion",
   "url": "https://github.com/bitcoin/bitcoin/pull/36525#issuecomment-6313228827"
  }
 ],
