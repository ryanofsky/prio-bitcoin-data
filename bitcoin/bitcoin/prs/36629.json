   "pin": null,
   "question": "",
   "quote": "Ordering spenders doesn't need a block read. txospenderindex keys already store a CDiskTxPos, and its nTxOffset grows with the transaction's position in the block.",
   "request": "Sort extra spenders by (height, tx_offset) using CDiskTxPos from txospenderindex instead of reading full blocks.",
   "status": "open",
   "status_by": null,
   "status_note": "",
   "type": "suggestion",
   "url": "https://github.com/bitcoin/bitcoin/pull/36629#pullrequestreview-5635280324"
