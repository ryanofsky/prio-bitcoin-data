     "type": "objection"
    }
   ],
   "id": "r:5635280324",
   "kind": "safety",
   "other_replies": [],
   "part": 1,
   "pin": null,
   "question": "",
   "quote": "The lookup budget does not count block and undo reads. At verbosity 2, tx_to_json reads the full block and its undo data for every block that holds a non-coinbase match",
   "request": "",
   "status": "open",
   "status_by": null,
   "status_note": "",
   "type": "objection",
   "url": "https://github.com/bitcoin/bitcoin/pull/36629#pullrequestreview-5635280324"
  },
