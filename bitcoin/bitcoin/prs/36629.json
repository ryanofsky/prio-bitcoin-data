   "pin": null,
   "question": "",
   "quote": "Could the RPC go in its own file? blockchain.cpp grows by ~530 lines to 4,238. The handler is one ~400-line lambda that opens with a 12-step index comment.",
   "request": "Move getscripthistory RPC handler into its own file (src/rpc/scripthistory.cpp) with one function per step.",
   "status": "open",
   "status_by": null,
   "status_note": "",
   "type": "suggestion",
   "url": "https://github.com/bitcoin/bitcoin/pull/36629#pullrequestreview-5635280324"
