   "pin": null,
   "question": "",
   "quote": "Find could take the whole set of script hashes. Today the RPC calls Find once per hash and merges results by (height, tx_offset).",
   "request": "Have Find take the whole set of script hashes to avoid duplicate transaction reads and simplify post-processing.",
   "status": "open",
   "status_by": null,
   "status_note": "",
   "type": "suggestion",
   "url": "https://github.com/bitcoin/bitcoin/pull/36629#pullrequestreview-5635280324"
