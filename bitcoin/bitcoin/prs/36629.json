   "question": "",
   "quote": "One budget, one error. Index lookups charge a uint64_t& and fail with \"Script history index lookup limit exceeded\u2026\". Extra transaction bodies throw a std::runtime_error",
   "request": "Unify index-layer and RPC-layer budget enforcement and error reporting into a single type.",
   "status": "open",
   "status_by": null,
   "status_note": "",
   "type": "suggestion",
   "url": "https://github.com/bitcoin/bitcoin/pull/36629#pullrequestreview-5635280324"
