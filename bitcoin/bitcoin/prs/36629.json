   "from_schema": 2,
   "harm": "The lookup budget does not count block and undo reads, allowing queries that fit in the 50 MiB budget to read far more disk than intended.",
   "hash": "bfb3806f81ac78e6",
   "history": [
    {
     "at": "2026-10-24T01:20:59+00:00",
     "by": "run:20261024-0116",
