   "part": 2,
   "pin": null,
   "question": "",
   "quote": "OrderedVarInt could be BigEndianFormatter<3>. Big-endian already sorts by height, and the same key already uses it for the tx offset.",
   "request": "Use BigEndianFormatter<3> instead of introducing OrderedVarInt.",
   "status": "open",
   "status_by": null,
   "status_note": "",
   "type": "suggestion",
   "url": "https://github.com/bitcoin/bitcoin/pull/36629#pullrequestreview-5635280324"
