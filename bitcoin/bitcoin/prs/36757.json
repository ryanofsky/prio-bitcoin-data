   "part": 1,
   "pin": null,
   "question": "Does CJDNS need to be treated similarly?",
   "quote": "Does CJDNS need to be treated similarly?",
   "request": "",
   "status": "answered",
   "status_by": {
    "at": "2026-11-05",
    "by": "stratospher",
    "id": "rc:4486875877",
    "quote": "good question. if I make an outbound connection to a cjdns peer running core, the cjdns peer will send all zeroes in `addrMe` in VERSION message (since it's not addr v1 compatible). so logically we could just ignore it like we do for tor/i2p. but I don't think there's a privacy risk here"
   },
   "status_note": "author and reviewers explained that CJDNS does not carry the same privacy risk and self-advertises",
   "type": "question",
   "url": "https://github.com/bitcoin/bitcoin/pull/36757#discussion_r4469993651"
  }
 ],
